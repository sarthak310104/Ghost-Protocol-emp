# --- Database ---
DATABASE_URL=postgresql+asyncpg://ghost:ghost@timescaledb:5432/ghost_protocol

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Behavioral graph baselines ---
BASELINE_WINDOW_MINUTES=30
BASELINE_EWMA_ALPHA=0.2
ANOMALY_ZSCORE_THRESHOLD=3.0

# --- App ---
GHOST_ENV=local
GHOST_LOG_LEVEL=INFO
# Fernet key for encrypting each workspace's reasoning-service API key at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GHOST_SECRET_KEY=changeme_generate_a_real_fernet_key

# --- Security ---
# Comma-separated list of origins allowed to make credentialed (cookie-
# bearing) requests to the dashboard API -- e.g. the Next.js frontend's
# origin. Never set this to "*".
GHOST_ALLOWED_ORIGINS=http://localhost:3000
GHOST_LOGIN_RATE_LIMIT_PER_MINUTE=10
# Session cookies get the Secure (HTTPS-only) flag whenever this isn't
# "local" -- set to "production" once TLS is terminated in front of
# the app in a real deployment.

# --- Public demo (optional) ---
# If set, seed_demo_workspace generates synthetic traffic and a real
# incident lifecycle for this one workspace on a schedule, so a
# public-facing deployment always has something real to show. Create
# the workspace first via POST /v1/admin/workspaces, then set its ID
# here. Leave unset ("") everywhere else -- the task is a no-op
# without it.
GHOST_DEMO_WORKSPACE_ID=

# --- Free-tier deployment mode (optional) ---
# When true, everything that would normally enqueue a Celery task
# instead runs synchronously in the same request/call -- removes the
# need for a persistent worker process entirely, since no mainstream
# host offers one genuinely free in 2026. Fine for a low-traffic public
# demo; leave false for a real deployment with real load.
GHOST_SYNC_MODE=false
# Required whenever GHOST_SYNC_MODE is true. Shared secret an external
# cron service presents (as X-Internal-Secret) to call POST
# /internal/tick, which substitutes for Celery beat's whole schedule.
# Generate with: python -c "import secrets; print(secrets.token_hex(24))"
GHOST_INTERNAL_SECRET=

# --- Reasoning connection (optional) ---
# Ghost Protocol implements NO reasoning itself. Per workspace (see the
# Workspace model / dashboard settings), you can optionally configure:
#   reasoning_endpoint_url    -> any external service implementing the
#                                 expected request/response contract
#   reasoning_api_key         -> bearer token for that endpoint (stored encrypted)
#   reasoning_provider_label  -> informational only ("custom", "unconfigured", etc.)
# There is nothing to set here at the process level -- it's per-workspace,
# set via the API/dashboard, not an env var. Without it configured, Ghost
# still ingests, models, detects, and simulates -- this is purely additive.